# Project NOMAD — install/management_compose.yaml environment overrides
#
# Copy this file to `.env` in the same directory as management_compose.yaml and
# set the values you want to change. Docker Compose auto-loads `.env` from the
# project directory, so `docker compose up -d` (or the install/start scripts)
# picks these up with no extra flags. Leave a line commented out to keep the
# built-in default shown next to it.

# Registry + organisation that supplies the three core Project NOMAD images:
#   project-nomad, project-nomad-sidecar-updater, project-nomad-disk-collector.
#
# Defaults to the official Crosstalk GHCR org (the value shown below), so an
# unset override is byte-identical to the pre-#12 image references. Set this to
# point the install at a mirror or a fork's registry instead, e.g.:
#   NOMAD_IMAGE_REGISTRY=ghcr.io/my-org
#   NOMAD_IMAGE_REGISTRY=my-registry.local:5000
#   NOMAD_IMAGE_REGISTRY=registry.example.com/nomad
#
# Only the registry/organisation prefix is overridden — the image name and tag
# (e.g. project-nomad:latest) are unchanged, so the image must exist under the
# registry you point at.
# NOMAD_IMAGE_REGISTRY=ghcr.io/crosstalk-solutions
